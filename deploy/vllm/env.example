# Copy to .env.local and adjust for this GPU host before sourcing.
#
# Milestone 1 keeps vLLM as an external OpenAI-compatible HTTP server. The
# gateway should call this endpoint; it should not import or manage vLLM.

export VLLM_MODEL="Qwen/Qwen3-8B"
export VLLM_SERVED_MODEL_NAME="Qwen/Qwen3-8B"
export VLLM_HOST="127.0.0.1"
export VLLM_PORT="8001"

# Use only physical GPU 4 for Milestone 1 local serving. The machine also has a
# DGX display GPU, so stable PCI ordering prevents unexpected device selection.
export CUDA_DEVICE_ORDER="PCI_BUS_ID"
export CUDA_VISIBLE_DEVICES="4"

# Match the explicit vLLM CUDA 11.8 wheel in pyproject.toml.
# Driver 535.x supports CUDA 11.8; newer CUDA 12.6/12.8/12.9 wheels are avoided.
export UV_TORCH_BACKEND="cu118"

# Keep cache locations explicit so saved experiments can record provenance.
# export HF_HOME="/mnt/models/huggingface"
# export VLLM_CACHE_ROOT="/mnt/models/vllm"

# Add vLLM CLI flags here for reproducible experiments, for example:
# export VLLM_EXTRA_ARGS="--max-model-len 4096 --gpu-memory-utilization 0.85"
export VLLM_EXTRA_ARGS=""
